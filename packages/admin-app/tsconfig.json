{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@yara/shared": ["../../packages/shared/index.ts"],
      "@yara/shared/*": ["../../packages/shared/*"]
    },
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["src/**/*", "App.tsx"]
}