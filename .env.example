# YARA Mobile — Environment Variables Template
# Copy to .env.local in each app package and fill in your values.
# NEVER commit .env.local to git.

# ──────────────────────────────────────────────
# Backend URLs (set to the machine running run_local.py)
# Find your LAN IP:
#   Windows: ipconfig | findstr "IPv4"
#   Mac/Linux: ifconfig | grep "inet " | grep -v 127
# ──────────────────────────────────────────────

# CH-3 ETA Engine — SSE stream + GTFS REST API
EXPO_PUBLIC_API_URL=http://192.168.1.100:8002

# CH-1 Simulator Control — fault injection REST API
EXPO_PUBLIC_SIM_URL=http://192.168.1.100:8001

# ──────────────────────────────────────────────
# Optional overrides (defaults from shared/constants.py)
# ──────────────────────────────────────────────

# SSE reconnect behavior
# EXPO_PUBLIC_SSE_RECONNECT_DELAY_MS=3000
# EXPO_PUBLIC_SSE_MAX_RECONNECT_ATTEMPTS=5

# ──────────────────────────────────────────────
# Production only (leave blank for local dev)
# ──────────────────────────────────────────────

# EXPO_PUBLIC_API_URL=https://api.yara.transit/v1
# EXPO_PUBLIC_SIM_URL=https://api.yara.transit/sim
